rules_version = '2';
// Firestore rules for the doctor survey at https://axyra.web.app/question/
// The survey page stores answers under survey/<passphrase>/responses/<id>.
// Only someone who knows the passphrase can read or write them: the rule compares the
// SHA-256 of the path segment with the hash below (the passphrase itself is never in this repo).
// To change the passphrase: put the uppercase SHA-256 hex of the new one below, publish the
// rules, then enter the new passphrase on each device. Old answers stay under the old path.
//
// Not deployed by GitHub Actions: paste this file into Firebase Console ->
// project axyra-website -> Firestore Database -> Rules -> Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    match /survey/{key}/responses/{id} {
      allow read, write: if hashing.sha256(key).toHexString() == '23DCB5359FD49D8D6E535D33DDC7F86D7A90747CE64570BB138E43CB786B8580'
        && (request.method == 'delete' || request.method == 'get' || request.method == 'list'
            || (request.resource.data.keys().hasOnly(['a', 'createdAt', 'updatedAt', 'v'])
                && request.resource.data.a is map
                && request.resource.size() < 200000));
    }
  }
}
