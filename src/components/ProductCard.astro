---
import { Picture, Image } from 'astro:assets';
import Icon from './Icon.astro';
import { productImage } from '../lib/images';
import { localePath, productExternalUrl, pageEnabled, type Lang } from '../lib/content';
interface Props { product: any; lang: Lang; learnMore: string; featured?: boolean }
const { product, lang, learnMore, featured = false } = Astro.props;
const t = product.text;
const icon = productImage(product.images?.icon);
const shot = productImage(product.images?.desktop);
const href = product.hasPage !== false && pageEnabled('products') ? localePath(lang, `/products/${product.slug}/`) : undefined;
const visit = productExternalUrl(product);
const themed = product.theme === 'dr-assistant';
---
<article class:list={['pcard', 'reveal', { featured, themed }]}>
  <div class="pcard-body">
    <div class="pcard-head">
      {icon && <Image src={icon} alt="" width={64} height={64} class="pcard-icon" />}
      <div>
        <h2 class="pcard-name">{t.name}</h2>
        {t.category && <p class="pcard-cat">{t.category}</p>}
      </div>
    </div>
    <p class="pcard-slogan">{t.slogan}</p>
    <p class="pcard-summary">{t.summary}</p>
    <div class="actions">
      {href && <a class="btn" href={href}>{learnMore}<span class="visually-hidden"> — {t.name}</span> <Icon name="arrow-right" class="icon--dir" /></a>}
      {visit && <a class="link-arrow" href={visit} target="_blank" rel="noopener">{t.visitButton || visit} <Icon name="arrow-up-right" /></a>}
    </div>
  </div>
  {featured && shot && (
    <div class="pcard-visual" aria-hidden="true">
      <Picture src={shot} alt="" formats={['avif', 'webp']} widths={[480, 800, 1200]} sizes="(max-width: 900px) 90vw, 560px" loading="lazy" />
    </div>
  )}
</article>
<style>
  .pcard { border-radius: var(--radius-lg); background: var(--bg-alt); overflow: hidden; display: grid; }
  .pcard.featured { grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); align-items: center; }
  @media (max-width: 900px) { .pcard.featured { grid-template-columns: 1fr; } }
  .pcard-body { padding: clamp(32px, 5vw, 64px); }
  .pcard-head { display: flex; align-items: center; gap: 18px; margin-bottom: 28px; }
  .pcard-head :global(.pcard-icon) { width: 64px; height: 64px; border-radius: 16px; }
  .pcard-name { font-size: clamp(1.75rem, 3vw, 2.25rem); }
  .pcard-cat { color: var(--text-muted); font-size: .9375rem; margin-top: 4px; }
  .pcard-slogan { font-size: clamp(1.25rem, 2.2vw, 1.625rem); font-weight: 700; letter-spacing: -.02em; line-height: 1.25; }
  .themed .pcard-slogan { background: var(--dra-gradient); -webkit-background-clip: text; background-clip: text; color: transparent; }
  [dir='rtl'] .pcard-slogan { letter-spacing: 0; line-height: 1.5; }
  .pcard-summary { margin-top: 14px; color: var(--text-muted); }
  .pcard-visual { align-self: stretch; display: flex; align-items: center; padding: clamp(24px, 4vw, 48px); padding-inline-start: 0; }
  @media (max-width: 900px) { .pcard-visual { padding: 0 24px 24px; } }
  .pcard-visual :global(img) { border-radius: 16px; box-shadow: var(--shadow); width: 100%; height: auto; }
</style>
