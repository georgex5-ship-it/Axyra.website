---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { readYaml, loadLocalized, langPaths, localePath, pageEnabled, isFilled, type Lang } from '../../lib/content';

export function getStaticPaths() { return langPaths('solutions'); }
const { lang } = Astro.props as { lang: Lang };
const raw = readYaml('pages/solutions.yaml');
const t = loadLocalized('pages/solutions.yaml', lang);
const areas = (raw.areas ?? [])
  .map((a: any, i: number) => ({ ...a, ...(t.areas?.[i] ?? {}) }))
  .filter((a: any) => a.show !== false && isFilled(a.title) && isFilled(a.summary));
---
<Base lang={lang} path="/solutions/" title={t.seo.title} description={t.seo.description}>
  <PageHero eyebrow={t.hero.eyebrow} title={t.hero.title} lead={t.hero.lead} />

  <nav class="jump container" aria-label={t.hero.eyebrow}>
    {areas.map((a: any) => <a href={`#${a.id}`}>{a.title}</a>)}
  </nav>

  {areas.map((a: any, i: number) => (
    <section class:list={['section', 'area', { 'section--alt': i % 2 === 1 }]} id={a.id} aria-labelledby={`${a.id}-h`}>
      <div class="container area-grid">
        <div class="reveal">
          <div class="area-icon"><Icon name={a.icon} /></div>
          <h2 id={`${a.id}-h`} class="title">{a.title}</h2>
          <p class="lead area-summary">{a.summary}</p>
        </div>
        <div class="reveal" style="--delay:.08s">
          {isFilled(a.details) && <p class="area-details">{a.details}</p>}
          {a.points?.length > 0 && (
            <ul class="points" role="list">
              {a.points.filter(isFilled).map((pt: string) => <li><Icon name="check" /> <span>{pt}</span></li>)}
            </ul>
          )}
        </div>
      </div>
    </section>
  ))}

  {pageEnabled('contact') && (
    <CtaBand title={t.cta.title} lead={t.cta.lead} button={t.cta.button} href={localePath(lang, '/contact/')} />
  )}
</Base>

<style>
  .jump { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: -24px; margin-bottom: clamp(32px, 6vw, 64px); }
  .jump a { padding: 10px 18px; border-radius: var(--radius-pill); border: 1px solid var(--line); color: var(--text); font-weight: 600; font-size: .9375rem; }
  .jump a:hover { text-decoration: none; border-color: color-mix(in srgb, var(--text) 35%, transparent); }
  .area { scroll-margin-top: var(--header-h); }
  .area-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(32px, 7vw, 112px); align-items: start; }
  @media (max-width: 820px) { .area-grid { grid-template-columns: 1fr; } }
  .area-icon {
    width: 72px; height: 72px; border-radius: 22px; display: grid; place-items: center; margin-bottom: 32px; color: #fff;
    background: var(--brand-gradient); box-shadow: 0 16px 40px -12px color-mix(in srgb, var(--brand-blue) 60%, transparent);
  }
  .area-icon :global(.icon) { width: 34px; height: 34px; }
  .area-summary { margin-top: 20px; }
  .area-details { font-size: 1.125rem; line-height: 1.7; }
  .points { list-style: none; margin: 32px 0 0; padding: 0; display: grid; gap: 14px; }
  .points li { display: flex; gap: 12px; align-items: flex-start; font-weight: 500; padding-bottom: 14px; border-bottom: 1px solid var(--line); }
  .points :global(.icon) { color: var(--link); margin-top: 3px; }
</style>
